<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Main Menu" name="MenuText" style="justify-content: center; -unity-text-align: middle-center; align-self: center; font-size: 60px; -unity-font-style: bold; -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(11, 10, 10); color: rgb(255, 255, 255); top: 56px;"/>
    <ui:Button text="Start" name="StartButton" style="align-self: center; justify-content: flex-start; font-size: 60px; color: rgb(0, 0, 0); -unity-text-outline-width: 0; background-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom-right-radius: 11px; border-bottom-left-radius: 11px; -unity-font-style: bold; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); align-content: center; position: relative; top: 85px; left: auto;"/>
    <ui:Button text="Quit" name="QuitButton" style="align-self: center; font-size: 60px; position: relative; top: 110px; left: auto; align-content: center; -unity-font-style: bold; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 11px; border-top-right-radius: 11px; border-bottom-right-radius: 11px; border-bottom-left-radius: 11px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); background-color: rgb(255, 255, 255);"/>
</ui:UXML>
